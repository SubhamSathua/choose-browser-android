<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/backgroundPrimary"
    android:orientation="vertical">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/aboutStickyHeader"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/backgroundPrimary"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="4dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/aboutBackBtn"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginRight="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="5dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ix_back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:fontFamily="@font/heading"
            android:text="About"
            android:textColor="@color/text"
            android:textSize="@dimen/font_16" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#22000000" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ════ HERO ════ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="10dp"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="4dp"
                app:cardBackgroundColor="@color/aboutPage_mainCard"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="10dp"
                    android:paddingTop="20dp"
                    android:paddingBottom="24dp">

                    <LinearLayout
                        android:id="@+id/heroContent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:gravity="center"
                        android:orientation="vertical">

                        <!-- Circular app icon -->
                        <androidx.cardview.widget.CardView
                            android:layout_width="60dp"
                            android:layout_height="60dp"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="30dp"
                            app:cardElevation="4dp">

                            <ImageView
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:contentDescription="App icon"
                                android:scaleType="centerCrop"
                                android:src="@drawable/main_icon" />

                        </androidx.cardview.widget.CardView>

                        <!-- App name -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:fontFamily="@font/brand"
                            android:text="@string/cfg_app_brand_name"
                            android:textColor="#FFFFFF"
                            android:textSize="@dimen/font_18dp" />

                        <!-- Version -->
                        <TextView
                            android:id="@+id/aboutVersion"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="3dp"
                            android:fontFamily="@font/body"
                            android:text="Version 1.0"
                            android:textColor="@color/aboutPage_textSecondary"
                            android:textSize="@dimen/font_12" />

                        <!-- Divider line -->
                        <View
                            android:layout_width="32dp"
                            android:layout_height="1dp"
                            android:layout_marginTop="10dp"
                            android:layout_marginBottom="8dp"
                            android:background="#555555" />

                        <!-- Dev tag -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:text="@string/cfg_made_by"
                            android:textColor="@color/aboutPage_textPrimary"
                            android:textSize="@dimen/font_12" />

                        <!-- Purpose text -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:layout_marginHorizontal="6dp"
                            android:fontFamily="@font/body"
                            android:gravity="center"
                            android:lineSpacingExtra="2dp"
                            android:text="@string/about_appTag"
                            android:textColor="@color/aboutPage_textPrimary"
                            android:textSize="@dimen/font_11" />

                    </LinearLayout>

                </RelativeLayout>

            </androidx.cardview.widget.CardView>

            <!-- ════ CONTENT ════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="10dp"
                android:paddingVertical="10dp">

                <!-- ── GitHub ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/aboutGithubRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/backgroundSecondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="GitHub"
                            android:padding="2dp"
                            android:src="@drawable/github" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="GitHub"
                                android:textColor="@color/text"
                                android:textSize="@dimen/font_14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="Source code &amp; releases"
                                android:textColor="@color/textSubSecondary"
                                android:textSize="@dimen/font_11" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Open"
                            android:src="@drawable/forward"
                            android:tint="@color/textSubSecondary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Feedback ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/aboutFeedbackRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/backgroundSecondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Feedback"
                            android:src="@drawable/ix_feedback" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="Feedback"
                                android:textColor="@color/text"
                                android:textSize="@dimen/font_14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="Share your thoughts"
                                android:textColor="@color/textSubSecondary"
                                android:textSize="@dimen/font_11" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Open"
                            android:src="@drawable/forward"
                            android:tint="@color/textSubSecondary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Privacy Policy ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/aboutPrivacyRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/backgroundSecondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Privacy Policy"
                            android:src="@drawable/ix_privacy" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="Privacy Policy"
                                android:textColor="@color/text"
                                android:textSize="@dimen/font_14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="How we handle your data"
                                android:textColor="@color/textSubSecondary"
                                android:textSize="@dimen/font_11" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Open"
                            android:src="@drawable/forward"
                            android:tint="@color/textSubSecondary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Contact Email ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/aboutEmailRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/backgroundSecondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Email"
                            android:src="@drawable/email" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="@string/cfg_email_card_title"
                                android:textColor="@color/text"
                                android:textSize="@dimen/font_14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="@string/cfg_contact_email"
                                android:textColor="@color/textSubSecondary"
                                android:textSize="@dimen/font_11" />

                        </LinearLayout>

                        <androidx.cardview.widget.CardView
                            android:id="@+id/emailCopyButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:clickable="true"
                            android:focusable="true"
                            android:foreground="?attr/selectableItemBackground"
                            app:cardBackgroundColor="@color/backgroundSecondary"
                            app:cardCornerRadius="12dp"
                            tools:cardBackgroundColor="#383838"
                            app:cardElevation="0dp">

                            <ImageView
                                android:id="@+id/aboutCopyEmail"
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:contentDescription="Copy email"
                                android:layout_margin="6dp"
                                android:src="@drawable/copy"
                                app:tint="@color/textSubSecondary" />

                        </androidx.cardview.widget.CardView>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <!-- ── Open Source Licenses ── -->
                <androidx.cardview.widget.CardView
                    android:id="@+id/aboutLicensesRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardBackgroundColor="@color/backgroundSecondary"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="12dp">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:contentDescription="Licenses"
                            android:src="@drawable/license" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="@string/open_source_licenses"
                                android:textColor="@color/text"
                                android:textSize="@dimen/font_14dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:fontFamily="@font/body"
                                android:text="@string/open_source_licenses_sub"
                                android:textColor="@color/textSubSecondary"
                                android:textSize="@dimen/font_11" />

                        </LinearLayout>

                        <ImageView
                            android:layout_width="16dp"
                            android:layout_height="16dp"
                            android:contentDescription="Open"
                            android:src="@drawable/forward"
                            android:tint="@color/textSubSecondary" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Footer -->
            <TextView
                android:id="@+id/aboutFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="24dp"
                android:fontFamily="@font/body"
                android:text=""
                android:textColor="@color/textSubSecondary"
                android:textSize="@dimen/font_11" />

        </LinearLayout>

    </ScrollView>

</LinearLayout>

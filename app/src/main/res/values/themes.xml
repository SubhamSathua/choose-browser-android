    <!-- Legacy / Fallback aliases -->
    <style name="ThemeOverlay.ChooseBrowserNEW.Color.monokai" parent="ThemeOverlay.ChooseBrowserNEW.Color.default" />

    <!-- Preview More bottom sheet: transparent bg so our drawable shows -->
    <style name="PreviewMoreBottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/PreviewMoreBottomSheetStyle</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:navigationBarColor">@color/previewPage_primary</item>
    </style>

    <style name="PreviewMoreBottomSheetStyle" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="backgroundTint">@android:color/transparent</item>
        <item name="shapeAppearanceOverlay">@style/PreviewMoreShapeOverlay</item>
    </style>

    <style name="PreviewMoreShapeOverlay">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>
    </style>



    <!-- Preview Top Sheet: Animation & Dialog -->
    <style name="Animation.TopSheet" parent="@android:style/Animation">
        <item name="android:windowEnterAnimation">@anim/slide_down_from_top</item>
        <item name="android:windowExitAnimation">@anim/slide_up_to_top</item>
    </style>

    <style name="PreviewTopSheetDialog" parent="Theme.MaterialComponents.Dialog">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowAnimationStyle">@style/Animation.TopSheet</item>
        <item name="android:statusBarColor">@color/previewPage_primary</item>
    </style>
</resources>



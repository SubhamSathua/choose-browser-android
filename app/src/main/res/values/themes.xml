        <item name="colorPopupDockButtonIcon">@color/default_popup_dock_button_icon</item>
        <item name="colorPopupAction">@color/default_popup_action</item>
        <item name="colorPopupText">@color/default_popup_text</item>
        <item name="colorPopupTitle">@color/default_popup_title</item>
        <item name="colorPopupAction1Icon">@color/default_popup_action1_icon</item>
        <item name="colorPopupAction2Icon">@color/default_popup_action2_icon</item>
        <item name="colorPopupAction3Icon">@color/default_popup_action3_icon</item>
        <item name="colorPopupDivider">@color/default_popup_divider</item>
    </style>


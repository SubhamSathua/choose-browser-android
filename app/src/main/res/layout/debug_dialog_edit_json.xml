<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_debug_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/heading"
        android:text="Edit JSON (Temp Override)"
        android:textColor="@color/text"
        android:textSize="17sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:fontFamily="@font/body"
        android:text="Applied immediately in memory. Cleared when app restarts."
        android:textColor="@color/textSub"
        android:textSize="12sp" />

    <!-- Action Toolbar (Format, Reset) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogJsonFormatBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/mono"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Format / Clean"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/dialogJsonResetBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/mono"
            android:paddingHorizontal="8dp"
            android:paddingVertical="4dp"
            android:text="Reset to Cached"
            android:textColor="?attr/colorPrimary"
            android:textSize="11sp" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/dialogJsonStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mono"
            android:textColor="@color/textSub"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Syntax Error Banner -->
    <TextView
        android:id="@+id/dialogJsonErrorBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:background="#2E1414"
        android:fontFamily="@font/mono"
        android:padding="8dp"
        android:textColor="#FF6B6B"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Code Editor Box -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="280dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_debug_json_box">

        <EditText
            android:id="@+id/dialogJsonInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:fontFamily="@font/mono"
            android:gravity="top|start"
            android:inputType="textMultiLine|textNoSuggestions"
            android:padding="12dp"
            android:textColor="#E0E0E0"
            android:textSize="12sp" />
    </ScrollView>

    <!-- Dialog Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center_vertical|end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/dialogJsonCancelBtn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/body"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:text="Cancel"
            android:textColor="@color/textSub"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/dialogJsonApplyBtn"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_debug_btn_primary"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/body"
            android:gravity="center"
            android:paddingHorizontal="16dp"
            android:text="Apply JSON"
            android:textColor="@color/PrimaryTextCol"
            android:textSize="13sp" />
    </LinearLayout>

</LinearLayout>

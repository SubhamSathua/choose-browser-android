<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_preview_more_sheet"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Drag handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/bg_preview_drag_handle" />

    <!-- Header Capsule: Icon/Thumbnail + Title + Subtitle/URL -->
    <LinearLayout
        android:id="@+id/ctxHeaderLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Thumbnail / Icon Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="44dp"
            android:layout_height="44dp"
            app:cardBackgroundColor="@color/previewPage_secondary"
            app:cardCornerRadius="8dp"
            app:cardElevation="0dp">

            <ImageView
                android:id="@+id/ctxHeaderIcon"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="8dp"
                android:scaleType="centerCrop"
                android:src="@drawable/link"
                app:tint="@color/previewPage_textSecondary" />
        </androidx.cardview.widget.CardView>

        <!-- Title & Subtitle -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/ctxHeaderTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="@font/inter"
                android:maxLines="1"
                android:textColor="@color/previewPage_textSecondary"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="Link / Image Title" />

            <TextView
                android:id="@+id/ctxHeaderUrl"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:fontFamily="@font/mono"
                android:maxLines="1"
                android:textColor="@color/previewPage_textSecondary"
                android:textSize="11sp"
                tools:text="https://example.com/very/long/url..." />
        </LinearLayout>

    </LinearLayout>

    <!-- Top Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="6dp"
        android:background="@color/previewPage_secondary" />

    <!-- Action items list -->
    <LinearLayout
        android:id="@+id/ctxActionsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- LINK ACTIONS GROUP -->
        <LinearLayout
            android:id="@+id/groupLinkActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Open With -->
            <LinearLayout
                android:id="@+id/ctxActionOpenWith"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_open_with"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_open_with" />
            </LinearLayout>

            <!-- Copy link address -->
            <LinearLayout
                android:id="@+id/ctxActionCopyLinkAddress"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/copy"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_copy_link_address" />
            </LinearLayout>

            <!-- Copy link text -->
            <LinearLayout
                android:id="@+id/ctxActionCopyLinkText"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ix_copy"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_copy_link_text" />
            </LinearLayout>

            <!-- Share link -->
            <LinearLayout
                android:id="@+id/ctxActionShareLink"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/share"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_share_link" />
            </LinearLayout>
        </LinearLayout>

        <!-- Section Divider between Link and Image -->
        <View
            android:id="@+id/ctxDividerImageLink"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginVertical="6dp"
            android:background="@color/previewPage_secondary"
            android:visibility="gone" />

        <!-- IMAGE ACTIONS GROUP -->
        <LinearLayout
            android:id="@+id/groupImageActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Open Full Image -->
            <LinearLayout
                android:id="@+id/ctxActionOpenFullImage"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_full"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_open_full_image" />
            </LinearLayout>

            <!-- Copy Image -->
            <LinearLayout
                android:id="@+id/ctxActionCopyImage"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ix_copy"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_copy_image" />
            </LinearLayout>

            <!-- Copy image link -->
            <LinearLayout
                android:id="@+id/ctxActionCopyImageLink"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/link"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_copy_image_link" />
            </LinearLayout>

            <!-- Download image -->
            <LinearLayout
                android:id="@+id/ctxActionDownloadImage"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_downloads"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_download_image" />
            </LinearLayout>

            <!-- Search Google for this image -->
            <LinearLayout
                android:id="@+id/ctxActionSearchGoogleImage"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/ix_search"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_search_google_image" />
            </LinearLayout>

            <!-- Share Image -->
            <LinearLayout
                android:id="@+id/ctxActionShareImage"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/share"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_share_image" />
            </LinearLayout>
        </LinearLayout>

        <!-- MEDIA (VIDEO / AUDIO) ACTIONS GROUP -->
        <LinearLayout
            android:id="@+id/groupMediaActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            tools:visibility="visible">

            <!-- Open Media -->
            <LinearLayout
                android:id="@+id/ctxActionOpenMedia"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_full"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/tvCtxOpenMediaText"
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_open_in_viewer" />
            </LinearLayout>

            <!-- Copy Media link -->
            <LinearLayout
                android:id="@+id/ctxActionCopyMediaLink"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/link"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/tvCtxCopyMediaText"
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_copy_media_link" />
            </LinearLayout>

            <!-- Download Media -->
            <LinearLayout
                android:id="@+id/ctxActionDownloadMedia"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_downloads"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/tvCtxDownloadMediaText"
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_download_media" />
            </LinearLayout>

            <!-- Share Media -->
            <LinearLayout
                android:id="@+id/ctxActionShareMedia"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/share"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/tvCtxShareMediaText"
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_share_media" />
            </LinearLayout>

            <!-- Open Media with -->
            <LinearLayout
                android:id="@+id/ctxActionOpenMediaWith"
                style="@style/PreviewContextMenuActionRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="14dp"
                    android:src="@drawable/pp_open_with"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewContextMenuActionText"
                    android:text="@string/ctx_open_with" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</LinearLayout>

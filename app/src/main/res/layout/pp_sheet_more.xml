<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_preview_more_sheet"
    android:orientation="vertical"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <!-- Drag Handle -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_drag_handle" />

    <!-- ===== Title Capsule Card (90% width, centred) ===== -->
    <LinearLayout
        android:id="@+id/siteInfoCard"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_site_card"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="8dp">

        <!-- Green status dot / Site icon -->
        <ImageView
            android:id="@+id/siteIcon"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/site_icon_demo" />

        <!-- Site title (horizontally scrollable with mini indicator and selectable) -->
        <HorizontalScrollView
            android:id="@+id/siteTitleScroll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:scrollbars="horizontal"
            android:scrollbarSize="2dp"
            android:scrollbarThumbHorizontal="@drawable/scrollbar_mini_thumb"
            android:fadeScrollbars="true"
            android:scrollbarDefaultDelayBeforeFade="600"
            android:scrollbarFadeDuration="300"
            android:overScrollMode="ifContentScrolls">

            <TextView
                android:id="@+id/siteTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/body"
                android:gravity="start|center_vertical"
                android:maxLines="1"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:text="Site Title"
                android:textColor="@color/previewPage_textSecondary"
                android:textIsSelectable="true"
                android:textSize="@dimen/font_14" />
        </HorizontalScrollView>

        <!-- Copy link (circular ripple bg) -->
        <ImageButton
            android:id="@+id/moreCopyLinkBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_preview_copy_btn_hover"
            android:contentDescription="Copy link"
            android:padding="7dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ix_copy"
            app:tint="@color/previewPage_textSecondary" />

        <!-- Reload -->
        <ImageButton
            android:id="@+id/moreReloadBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/bg_preview_copy_btn_hover"
            android:contentDescription="Reload"
            android:padding="8dp"
            android:scaleType="fitCenter"
            android:src="@drawable/reload"
            app:tint="@color/previewPage_textSecondary" />
    </LinearLayout>

    <!-- ===== 4cX2r Big Card (same margin as title capsule) ===== -->
    <LinearLayout
        android:id="@+id/bg_grid_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_preview_grid_card"
        android:orientation="vertical"
        android:paddingVertical="8dp"
        android:paddingHorizontal="4dp">

        <!-- Row 1: Open In, Home, Print, Find -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/moreOpenIn"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/pp_open_with"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Open in" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreHome"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/home"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Home" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/morePrint"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/print"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Print" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreFind"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/find"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Find" />
            </LinearLayout>
        </LinearLayout>

        <!-- Row 2: Share, Ad Block, Permissions, Fire -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/moreShare"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ix_share"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Share" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreAdBlock"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/adBlockIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ad_close"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/adBlockText"
                    style="@style/PreviewMoreGridText"
                    android:text="Ad Blocker" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreDownloads"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/pp_downloads"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    style="@style/PreviewMoreGridText"
                    android:text="Downloads" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/moreDarkMode"
                style="@style/PreviewMoreGridItem"
                android:layout_width="0dp"
                android:layout_weight="1">
                <ImageView
                    android:id="@+id/darkModeIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/darkmode_off"
                    app:tint="@color/previewPage_textSecondary" />
                <TextView
                    android:id="@+id/darkModeText"
                    style="@style/PreviewMoreGridText"
                    android:text="Dark Mode" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== Toggles section ===== -->

    <!-- Open in App row -->
    <LinearLayout
        android:id="@+id/rowOpenInApp"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_preview_grid_item_hover"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/ivOpenInAppIcon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/pp_open_in_apps"
            app:tint="@color/previewPage_textSecondary" />

        <TextView
            android:id="@+id/tvOpenInAppTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/body"
            android:text="Open in app"
            android:textColor="@color/previewPage_textSecondary"
            android:textSize="@dimen/font_14" />

        <TextView
            android:id="@+id/tvOpenInAppName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/body"
            android:textColor="#99ffffff"
            android:textSize="@dimen/font_12" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/forward"
            android:alpha="0.5"
            app:tint="@color/previewPage_textSecondary" />
    </LinearLayout>

    <!-- Desktop Site toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/desktop"
            app:tint="@color/previewPage_textSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/body"
            android:text="Desktop Site"
            android:textColor="@color/previewPage_textSecondary"
            android:textSize="@dimen/font_14" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchDesktopSite"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Screenshot toggle -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/screenshot"
            app:tint="@color/previewPage_textSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/body"
            android:text="Allow Screenshot"
            android:textColor="@color/previewPage_textSecondary"
            android:textSize="@dimen/font_14" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switchScreenshot"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- Advanced (Collapsible) Header -->
    <LinearLayout
        android:id="@+id/rowAdvancedSettings"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_preview_grid_item_hover"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ix_settings"
            app:tint="@color/previewPage_textSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/body"
            android:text="Advanced"
            android:textColor="@color/previewPage_textSecondary"
            android:textSize="@dimen/font_14" />

        <ImageView
            android:id="@+id/ivAdvancedChevron"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/forward"
            android:alpha="0.6"
            app:tint="@color/previewPage_textSecondary" />
    </LinearLayout>

    <!-- Advanced Collapsible Container -->
    <LinearLayout
        android:id="@+id/layoutAdvancedSettings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Allow JS toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/js_on"
                app:tint="@color/previewPage_textSecondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/body"
                android:text="Allow JavaScript"
                android:textColor="@color/previewPage_textSecondary"
                android:textSize="@dimen/font_14" />

            <ImageButton
                android:id="@+id/btnInfoAllowJs"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="JavaScript info"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/info_24px"
                app:tint="@color/previewPage_textSecondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAllowJs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Allow HTTP connection toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/pp_site_warning"
                app:tint="@color/previewPage_textSecondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/body"
                android:text="Allow HTTP connection"
                android:textColor="@color/previewPage_textSecondary"
                android:textSize="@dimen/font_14" />

            <ImageButton
                android:id="@+id/btnInfoAllowHttp"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="HTTP connection info"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/info_24px"
                app:tint="@color/previewPage_textSecondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAllowHttp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <!-- Allow Download toggle -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="8dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_marginEnd="12dp"
                android:src="@drawable/pp_downloads"
                app:tint="@color/previewPage_textSecondary" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/body"
                android:text="Allow Download"
                android:textColor="@color/previewPage_textSecondary"
                android:textSize="@dimen/font_14" />

            <ImageButton
                android:id="@+id/btnInfoAllowDownload"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Download info"
                android:padding="6dp"
                android:scaleType="fitCenter"
                android:src="@drawable/info_24px"
                app:tint="@color/previewPage_textSecondary" />

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/switchAllowDownload"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

    </LinearLayout>

    <!-- Ad-Blocker Mode row -->
    <LinearLayout
        android:id="@+id/moreAdBlockMode"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginHorizontal="20dp"
        android:background="@drawable/bg_preview_grid_item_hover"
        android:clickable="true"
        android:focusable="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="12dp"
            android:src="@drawable/ad_close"
            app:tint="@color/previewPage_textSecondary" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="@font/body"
            android:text="Ad-Blocker Mode"
            android:textColor="@color/previewPage_textSecondary"
            android:textSize="@dimen/font_14" />

        <TextView
            android:id="@+id/tvAdBlockMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/body"
            android:text="Domain Filter"
            android:textColor="#99ffffff"
            android:textSize="@dimen/font_12" />

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_marginStart="6dp"
            android:src="@drawable/forward"
            android:alpha="0.5"
            app:tint="@color/previewPage_textSecondary" />
    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginHorizontal="20dp"
        android:layout_marginVertical="6dp"
        android:background="@color/previewPage_secondary" />

    <!-- Permissions -->
    <TextView
        android:id="@+id/morePermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/body"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        android:text="Permissions"
        android:textColor="@color/previewPage_textSecondary"
        android:textSize="@dimen/font_14"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />

    <!-- Privacy Policy -->
    <TextView
        android:id="@+id/morePrivacyPolicy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="20dp"
        android:fontFamily="@font/body"
        android:paddingHorizontal="8dp"
        android:paddingVertical="10dp"
        android:text="Privacy Policy"
        android:textColor="@color/previewPage_textSecondary"
        android:textSize="@dimen/font_14"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackground" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_preview_more_sheet"
    android:orientation="vertical"
    android:paddingHorizontal="20dp"
    android:paddingTop="14dp"
    android:paddingBottom="20dp">

    <!-- Top Drag Handle -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="14dp"
        android:background="@drawable/bg_preview_drag_handle" />

    <!-- File Header Row (Matching Opera mockup) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- Circular file type badge -->
        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_preview_addr_btn_ripple">

            <ImageView
                android:id="@+id/ivPromptFileIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:src="@drawable/pp_downloads"
                app:tint="#FFFFFF" />
        </FrameLayout>

        <!-- Editable File Name Input -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/etPromptFileName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:fontFamily="@font/inter"
                    android:imeOptions="actionDone"
                    android:inputType="textUri"
                    android:maxLines="2"
                    android:textColor="#FFFFFF"
                    android:textCursorDrawable="@drawable/cursor_dynamic"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="download-1.jpeg" />

                <ImageView
                    android:id="@+id/ivPromptEditName"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:layout_marginStart="6dp"
                    android:src="@drawable/ic_edit"
                    app:tint="#80FFFFFF" />
            </LinearLayout>

            <!-- Destination Folder Chip -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_preview_addr_action_btn"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp">

                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/ic_folder"
                    app:tint="#80FFFFFF" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:fontFamily="@font/inter"
                    android:text="Download/ChooseBrowser"
                    android:textColor="#B3FFFFFF"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- File Size & Info -->
    <TextView
        android:id="@+id/tvPromptFileSize"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/inter"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        tools:text="Size: 3.2 kB" />

    <!-- ══════ SAFE STATE ACTIONS ══════ -->
    <LinearLayout
        android:id="@+id/layoutSafeActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical">

        <!-- Download Action Row -->
        <LinearLayout
            android:id="@+id/rowSafeDownload"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="@drawable/bg_preview_grid_item_hover"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/pp_downloads"
                app:tint="#FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Download"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cancel Action Row -->
        <LinearLayout
            android:id="@+id/rowSafeCancel"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_preview_grid_item_hover"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/close"
                app:tint="#80FFFFFF" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Cancel"
                android:textColor="#B3FFFFFF"
                android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ══════ HARMFUL FILE WARNING CARD ══════ -->
    <LinearLayout
        android:id="@+id/layoutHarmfulCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:background="@drawable/bg_preview_url_box"
        android:orientation="vertical"
        android:padding="14dp"
        android:visibility="gone"
        tools:visibility="visible">

        <!-- Solid Yellow Warning Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/pp_site_warning"
                app:tint="#FFD600" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Harmful File Warning"
                android:textColor="#FFD600"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvHarmfulDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:fontFamily="@font/inter"
            android:lineSpacingExtra="2dp"
            android:text="This file is an executable or script application (.apk, .exe, etc.). It could harm your device or access personal data. ChooseBrowser is not responsible for files downloaded from third-party sites."
            android:textColor="#CCFFFFFF"
            android:textSize="12sp" />

        <!-- Collapsible Advanced Options Header -->
        <LinearLayout
            android:id="@+id/headerAdvancedOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_preview_addr_action_btn"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="@font/inter"
                android:text="Advanced Options"
                android:textColor="#B3FFFFFF"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/tvAdvancedArrow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="▼"
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Collapsible Container (Collapsed by Default) -->
        <LinearLayout
            android:id="@+id/containerAdvancedOptions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/inter"
                android:text="Only proceed if you completely trust this source."
                android:textColor="#80FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnDownloadAnyway"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#FF5252"
                android:fontFamily="@font/inter"
                android:text="Download Anyway"
                android:textColor="#FFFFFF"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Cancel row for harmful state -->
        <Button
            android:id="@+id/btnHarmfulCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginTop="8dp"
            android:fontFamily="@font/inter"
            android:text="Cancel &amp; Don't Download"
            android:textColor="#99FFFFFF" />
    </LinearLayout>

</LinearLayout>

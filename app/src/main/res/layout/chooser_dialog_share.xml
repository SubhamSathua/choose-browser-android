<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shareDialogRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="16dp"
    android:background="@drawable/bg_show_link_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header: back (optional) + icon badge + title/subtitle + close button -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:layout_marginBottom="14dp">

        <!-- Back button (visible in QR mode) -->
        <ImageView
            android:id="@+id/shareBackBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_show_link_close_btn"
            android:clickable="true"
            android:contentDescription="Back"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_back_24"
            android:visibility="gone" />

        <!-- Icon badge -->
        <FrameLayout
            android:id="@+id/shareIconContainer"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:background="@drawable/bg_show_link_close_btn">

            <ImageView
                android:id="@+id/shareIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:src="@drawable/ix_share" />
        </FrameLayout>

        <!-- Title & Subtitle column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/shareTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/heading"
                android:text="Share Link"
                android:textSize="@dimen/font_18"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/shareSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:ellipsize="middle"
                android:fontFamily="@font/body"
                android:singleLine="true"
                android:textSize="@dimen/font_12"
                tools:text="github.com • 142 chars" />
        </LinearLayout>

        <!-- Close button (circular) -->
        <ImageView
            android:id="@+id/shareCloseBtn"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_show_link_close_btn"
            android:clickable="true"
            android:contentDescription="Close"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:padding="9dp"
            android:src="@drawable/ic_close_24" />

    </LinearLayout>

    <!-- ===== MODE 1: Share Menu Options ===== -->
    <LinearLayout
        android:id="@+id/shareOptionsMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- URL preview pill card -->
        <LinearLayout
            android:id="@+id/shareUrlPreviewCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_show_link_url_box"
            android:orientation="vertical"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/sharePreviewDomain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/body"
                android:textStyle="bold"
                android:textSize="@dimen/font_13"
                tools:text="github.com" />

            <TextView
                android:id="@+id/sharePreviewUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="middle"
                android:fontFamily="@font/body"
                android:maxLines="2"
                android:textSize="@dimen/font_12"
                tools:text="https://github.com/SubhamSathua/choose-browser-android" />
        </LinearLayout>

        <!-- Share Actions Grid (2 rows x 2 cols) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Row 1: QR Code + Copy Link -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="8dp">

                <!-- Action 1: QR Code -->
                <LinearLayout
                    android:id="@+id/actionQrCode"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_show_link_url_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/actionQrIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_qr_code_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/actionQrTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:text="QR Code"
                            android:textSize="@dimen/font_13"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/actionQrDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:singleLine="true"
                            android:text="Scan with camera"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action 2: Copy Link -->
                <LinearLayout
                    android:id="@+id/actionCopyLink"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_show_link_url_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/actionCopyIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_content_copy_clean_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/actionCopyTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:text="Copy Link"
                            android:textSize="@dimen/font_13"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/actionCopyDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:singleLine="true"
                            android:text="To clipboard"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Row 2: Clean & Share + More Apps (System Chooser) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- Action 3: Clean & Share -->
                <LinearLayout
                    android:id="@+id/actionCleanShare"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_show_link_url_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/actionCleanIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ic_clean_sparkle_24" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/actionCleanTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:text="Clean Link"
                            android:textSize="@dimen/font_13"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/actionCleanDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:singleLine="true"
                            android:text="Strip trackers"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Action 4: More Apps (System Chooser) -->
                <LinearLayout
                    android:id="@+id/actionMoreApps"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_show_link_url_box"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="12dp">

                    <ImageView
                        android:id="@+id/actionMoreIcon"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginEnd="10dp"
                        android:src="@drawable/ix_share" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/actionMoreTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:text="More Apps"
                            android:textSize="@dimen/font_13"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/actionMoreDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/body"
                            android:singleLine="true"
                            android:text="System share sheet"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

    <!-- ===== MODE 2: Chrome-Style QR Code View ===== -->
    <LinearLayout
        android:id="@+id/shareQrMode"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- Scannable QR Code card (solid high-contrast white container) -->
        <FrameLayout
            android:id="@+id/qrCardFrame"
            android:layout_width="230dp"
            android:layout_height="230dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/bg_qr_code_card"
            android:padding="16dp"
            android:elevation="2dp">

            <ImageView
                android:id="@+id/qrImageView"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="Scannable QR code"
                android:scaleType="fitCenter" />
        </FrameLayout>

        <!-- Truncated link snippet below QR code -->
        <TextView
            android:id="@+id/qrLinkText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:layout_marginHorizontal="8dp"
            android:ellipsize="middle"
            android:fontFamily="@font/body"
            android:gravity="center"
            android:singleLine="true"
            android:textSize="@dimen/font_12"
            tools:text="https://github.com/SubhamSathua/choose-browser-android" />

        <!-- Bottom Actions Row for QR Mode: [Download QR] [Share Image] [Copy Link] -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Download button -->
            <LinearLayout
                android:id="@+id/qrDownloadBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_show_link_copy_clean_btn"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/qrDownloadIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ix_download" />

                <TextView
                    android:id="@+id/qrDownloadText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/body"
                    android:text="Download"
                    android:textSize="@dimen/font_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Share Image button -->
            <LinearLayout
                android:id="@+id/qrShareImageBtn"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:background="@drawable/bg_show_link_copy_clean_btn"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/qrShareImageIcon"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginEnd="6dp"
                    android:src="@drawable/ix_share" />

                <TextView
                    android:id="@+id/qrShareImageText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/body"
                    android:text="Share Image"
                    android:textSize="@dimen/font_13"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Spacer -->
            <View
                android:layout_width="8dp"
                android:layout_height="1dp" />

            <!-- Circular Copy Link button -->
            <ImageView
                android:id="@+id/qrCopyBtn"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_show_link_copy_clean_btn"
                android:clickable="true"
                android:contentDescription="Copy Link"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackgroundBorderless"
                android:padding="12dp"
                android:src="@drawable/ic_content_copy_clean_24" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginBottom="10dp"
    app:cardBackgroundColor="@color/backgroundSecondary"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Header: Icon + Name + Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/ivAppIcon"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:scaleType="fitCenter"
                tools:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:fontFamily="@font/heading"
                    android:maxLines="1"
                    android:textColor="@color/text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    tools:text="Flipkart" />

                <TextView
                    android:id="@+id/tvPackageName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="middle"
                    android:fontFamily="@font/mono"
                    android:maxLines="1"
                    android:textColor="@color/textSub"
                    android:textSize="11sp"
                    tools:text="com.flipkart.android" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvLinksCountBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_preview_addr_action_btn"
                android:fontFamily="@font/mono"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:textColor="#377aff"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:text="6 links" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="10dp"
            android:background="#18888888" />

        <!-- Supported Links List (Bullet / dash subtext) -->
        <TextView
            android:id="@+id/tvSupportedLinks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/mono"
            android:lineSpacingExtra="4dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="12sp"
            tools:text="- https://*.flipkart.com\n- https://dl.flipkart.com\n- https://www.flipkart.com\n- flipkart://*" />

        <!-- Expand / Collapse Toggle -->
        <TextView
            android:id="@+id/tvToggleExpand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:clickable="true"
            android:focusable="true"
            android:fontFamily="@font/body"
            android:text="Show more links..."
            android:textColor="#377aff"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
